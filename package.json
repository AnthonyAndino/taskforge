{
  "name": "taskforge",
  "version": "1.0.0",
  "description": "Kanban-style project management platform with real-time collaboration, REST API, CLI client, and React dashboard",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "cli": "tsx cli/index.ts",
    "dashboard": "npm run dev & cd dashboard && npm run dev",
    "db:seed": "tsx seed.ts"
  },
  "keywords": ["taskforge", "kanban", "project-management", "express", "typescript", "react", "websocket"],
  "author": "Anthony Andino",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
